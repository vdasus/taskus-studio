<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TaskusStudio.ViewModels"
        x:Class="TaskusStudio.Views.TemplateDialog"
        Title="New task" Width="620" Height="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Classes="h1" Text="Start from" Margin="0,0,0,10" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CreateButton" Content="Create" Classes="accent" MinWidth="90" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" />
    </StackPanel>
    <ListBox x:Name="List">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TemplateInfo">
          <StackPanel Spacing="2" Margin="0,4">
            <TextBlock Classes="label" Text="{Binding Name}" />
            <TextBlock Classes="muted" Text="{Binding Description}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
