<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PanelBrush" Color="#F7F7F9" />
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E3E8" />
          <SolidColorBrush x:Key="MutedBrush" Color="#6B6B76" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="WarnBrush" Color="#9D5D00" />
          <SolidColorBrush x:Key="OkBrush" Color="#0F7B0F" />
          <SolidColorBrush x:Key="BannerBrush" Color="#FFF4CE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PanelBrush" Color="#1E1E22" />
          <SolidColorBrush x:Key="CardBrush" Color="#2A2A30" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A42" />
          <SolidColorBrush x:Key="MutedBrush" Color="#A0A0AC" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="WarnBrush" Color="#FCE100" />
          <SolidColorBrush x:Key="OkBrush" Color="#6CCB5F" />
          <SolidColorBrush x:Key="BannerBrush" Color="#433519" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="TextBox.FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="SelectableTextBlock.FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="TextBlock.FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="TextBox.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Title strip of a collapsed panel: a checked toggle, drawn like a plain button. -->
  <Style Selector="ToggleButton.strip">
    <Setter Property="Padding" Value="4,6" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.strip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
  </Style>
  <Style Selector="ToggleButton.strip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
  </Style>
</Styles>
