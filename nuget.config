<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- A Taskus.Core built locally (dotnet pack ../Taskus/src/Taskus.Core -o local-packages) before it is on nuget.org. -->
    <add key="local" value="local-packages" />
  </packageSources>
</configuration>
